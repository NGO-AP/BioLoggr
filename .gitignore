# Environment & secrets (zero-leak)
.env*
!.env.example
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Local database & user uploads (keep on disk, not in git)
biologgr.db
backend/uploads/*
!backend/uploads/.gitkeep

# Node / frontend build artifacts (see also frontend/.gitignore)
node_modules/
frontend/test-results/

# OS
.DS_Store
Thumbs.db
